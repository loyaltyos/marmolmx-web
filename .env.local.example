# OpenPay Sandbox
# Usa las credenciales del dashboard Sandbox durante desarrollo.
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=
NEXT_PUBLIC_OPENPAY_SANDBOX=true
OPENPAY_PRIVATE_KEY=
OPENPAY_SANDBOX=true

# OpenPay Producción
# Antes de publicar, reemplaza las tres credenciales anteriores por las de producción.
# Cambia NEXT_PUBLIC_OPENPAY_SANDBOX=false y OPENPAY_SANDBOX=false.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
